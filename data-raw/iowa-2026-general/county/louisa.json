 "measures": [
  {
   "name": "Kirkwood Community College (Merged Area X) Bond - Public Measure NC",
   "jurisdiction": "Kirkwood Community College (Merged Area X)",
   "ballotLanguage": "Shall Kirkwood Community College (Merged Area X) in the Counties of Benton, Black Hawk, Buchanan, Cedar, Clinton, Delaware, Dubuque, Iowa, Jackson, Jefferson, Johnson, Jones, Keokuk, Linn, Louisa, Poweshiek, Tama, and Washington, be authorized to renovate, improve, erect, and equip facilities to modernize learning spaces with an emphasis on health sciences, industrial technologies, agricultural sciences, and business and information technology, contract indebtedness therefor, and issue General Obligation Bonds in an amount not exceeding $88,000,000 for those purposes?"
  },
  {
   "name": "Lone Tree Community School District Bond - Public Measure MA",
   "jurisdiction": "Lone Tree Community School District (Johnson, Louisa counties)",
   "ballotLanguage": "Shall the Board of Directors of the Lone Tree Community School District in the Counties of Johnson and Louisa, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $6,900,000 to provide funds to remodel, repair, and improve the school building for energy efficiency, including HVAC, mechanical, electrical, and site improvements?"
  }
 ],
 "notes": "Sources: official 2026 General Election public notice (text PDF, release date October 14, 2026, lists all contests/candidates and measure text) cross-checked against 19 precinct sample ballot PDFs (scanned; read via OCR) for parties and vote-for counts. Supervisor: a single vote-for-one race appears on every precinct ballot = at-large. Township trustee and clerk races are vote-for-one; Columbus City Township Clerk, Concord Township Trustee and Oakland Township (trustee and clerk) have no candidates. Measure NC (Kirkwood bond) appears only on the Kirkwood-area ballot styles (503 Columbus City-Kirkwood, 507 Oakland Twp-Kirkwood & Lone Tree); Measure MA (Lone Tree CSD bond) only on 507."
