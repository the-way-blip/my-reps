 "measures": [
  {
   "name": "Public Measure LI (City of Bellevue GO Bond — swimming pool)",
   "jurisdiction": "City of Bellevue (Precinct 1 Bellevue City ballot)",
   "ballotLanguage": "Shall the City of Bellevue, in Jackson County, State of Iowa, enter into a loan agreement and issue general obligation bonds in an amount not exceeding $3,000,000 for the purpose of paying the cost, to that extent, of undertaking the construction, furnishing & equipping a new municipal swimming pool, including a splash pad?"
  },
  {
   "name": "Public Measure LJ (Easton Valley Community School District GO Bond)",
   "jurisdiction": "Easton Valley Community School District (8 Jackson ballot styles)",
   "ballotLanguage": "Shall the Board of Directors of the Easton Valley Community School District, in the Counties of Clinton and Jackson, State of Iowa, be authorized to contract indebtedness and issue general obligation bonds in an amount not exceeding $7,500,000 for the purposes of acquiring, furnishing, equipping, constructing, and improving the School District's school buildings to include a new gymnasium and new locker room facilities that include a FEMA-rated storm shelter, performing arts upgrades to the existing gym, ADA updates, and other related building, site and land improvements?"
  },
  {
   "name": "Public Measure NC (Kirkwood Community College GO Bond)",
   "jurisdiction": "Kirkwood Community College (Merged Area X) (3 Jackson ballot styles: pct_3_brandon_township_kirkwood, pct_6_monmouth_city, pct_6_monmouth_township_kirkwood)",
   "ballotLanguage": "Shall Kirkwood Community College (Merged Area X) in the Counties of Benton, Black Hawk, Buchanan, Cedar, Clinton, Delaware, Dubuque, Iowa, Jackson, Jefferson, Johnson, Jones, Keokuk, Linn, Louisa, Poweshiek, Tama, and Washington, be authorized to renovate, improve, erect, and equip facilities to modernize learning spaces with an emphasis on health sciences, industrial technologies, agricultural sciences, and business and information technology, contract indebtedness therefor, and issue General Obligation Bonds in an amount not exceeding $88,000,000 for those purposes?"
  }
 ],
 "notes": "Parsed from official per-precinct/township sample ballots (37 styles), consistent with the county candidate listing. Supervisor Districts 2 and 3 appear on every ballot style countywide, so supervisors are elected at-large (residency districts). All county partisan offices have only a Republican candidate. Empty candidate lists = 'No candidates filed' (Tete Des Morts Twp Trustee, Union Twp Trustee and Clerk). Fairfield Township ballot has no township races. Hospital trustee race: vote for four, three candidates."
