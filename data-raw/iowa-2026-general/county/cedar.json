 "measures": [
  {
   "name": "Tipton Community School District Public Measure A",
   "jurisdiction": "Tipton Community School District",
   "ballotLanguage": "Shall the Board of Directors of the Tipton Community School District in the County of Cedar, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $16,100,000 to provide funds to build, furnish, and equip additions to the high school, including a secure entrance, gymnasium, and commons area; to remodel, repair, improve, and equip the high school, including educational and administrative spaces; and to improve the site, including parking?"
  },
  {
   "name": "Kirkwood Community College (Merged Area X) Public Measure NC",
   "jurisdiction": "Kirkwood Community College Merged Area X (Cedar County portion)",
   "ballotLanguage": "Shall Kirkwood Community College (Merged Area X) in the Counties of Benton, Black Hawk, Buchanan, Cedar, Clinton, Delaware, Dubuque, Iowa, Jackson, Jefferson, Johnson, Jones, Keokuk, Linn, Louisa, Poweshiek, Tama, and Washington, be authorized to renovate, improve, erect, and equip facilities to modernize learning spaces with an emphasis on health sciences, industrial technologies, agricultural sciences, and business and information technology, contract indebtedness therefor, and issue General Obligation Bonds in an amount not exceeding $88,000,000 for those purposes?"
  }
 ],
 "notes": "Parsed from all 38 official precinct/ballot-style sample ballots on the Cedar County elections site. Board of Supervisors is at-large: every ballot shows 'County Board of Supervisors - Vote for no more than two' (candidate order rotates between styles). Regular Soil and Water Conservation District race (vote for two) has no filed candidates (write-in only); separate SWCD vacancy race. Ag Extension: 4 candidates for 5 seats. No county hospital trustee race. Tipton CSD bond appears on 11 ballot styles; Kirkwood Community College bond on 27 ballot styles (all styles marked kcc/tiptonkcc plus Tipton precincts)."
