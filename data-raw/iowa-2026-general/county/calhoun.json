 "measures": [
  {
   "name": "Pocahontas Area Community School District Public Measure RQ",
   "jurisdiction": "Pocahontas Area Community School District (Calhoun County portion: Pomeroy, Butler Twp, Sherman Twp, Williams Twp precinct ballot styles)",
   "ballotLanguage": "Shall the Board of Directors of the Pocahontas Area Community School District in the Counties of Pocahontas, Calhoun and Palo Alto, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $20,000,000 to provide funds to remodel, repair, improve, and equip the middle/high school and elementary school, including career and technical education and classroom spaces; to build, furnish, and equip additions to the middle/high school and elementary school, including site improvements; for playground improvements at the elementary school; and to build, furnish, and equip a central office and regional learning center building and a transportation facility, including site improvements?"
  }
 ],
 "notes": "Parsed from all 29 official precinct/ballot-style sample ballots posted by the Calhoun County Auditor. Supervisors are elected by district: only District 2 is on the ballot (appears on 9 ballot styles: Calhoun, Elm Grove, Jackson, S. Lake Creek, S. Logan, Reading, Union townships, Lake City & Yetter, Farnhamville & Lohrville); voters see only their district. County Treasurer candidate M. Alan Ellis has no party label on the ballot. A County Auditor vacancy race is on the ballot. Township races with empty candidate lists are on the ballot with write-in lines only. N./S. Greenfield, N./S. Lake Creek and N./S. Logan precincts share the same township races. No county hospital trustee race appears."
