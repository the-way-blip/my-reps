 "measures": [
  {
   "name": "Public Measure \"A\"",
   "jurisdiction": "Wapello County",
   "ballotLanguage": "\"Shall the county of Wapello, state of Iowa, issue its general obligation bonds or capital loan notes in an amount not exceeding the amount of $45,000,000 for the purpose of designing, erecting, reconstructing, extending, equipping, and furnishing of the existing jail facility including expansion of the existing jail facility and related grounds and site improvements?\""
  },
  {
   "name": "Public Measure \"MN\"",
   "jurisdiction": "Pekin Community School District",
   "ballotLanguage": "Shall the Board of Directors of the Pekin Community School District in the Counties of Jefferson, Keokuk, Wapello, and Washington, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $9,200,000 to provide funds to build, furnish, and equip additions to the school building, including classroom and commons area spaces; to remodel, repair, improve, and equip the school building, including a secure entrance, HVAC, mechanical, electrical, plumbing, parking, accessibility, and site improvements?"
  },
  {
   "name": "Public Measure \"LR\"",
   "jurisdiction": "Fairfield Community School District",
   "ballotLanguage": "Shall the Board of Directors of the Fairfield Community School District in the Counties of Jefferson, Henry, Van Buren, Wapello and Washington, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $24,850,000 to provide funds to build furnish, and equip additions to and to remodel, repair, improve, and equip the middle school building, including fine arts, career and technical education, library, commons area, kitchen, and gymnasium spaces, including related site improvements?"
  }
 ],
 "notes": "Source: combined official sample ballot PDF (all precinct styles). Board of Supervisors is at-large (same 2-seat contest, same four candidates on every ballot style). County Auditor to fill vacancy also on ballot. Some township offices have no printed candidates (write-in only): Pleasant Township Trustee/Clerk, Cass Township Clerk, Keokuk Township Trustee (to fill vacancy). Measures MN and LR are school-district bond questions appearing only on ballots for precincts within those districts."
}