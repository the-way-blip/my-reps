 "measures": [
  {
   "name": "AGWSR Public Measure IR",
   "jurisdiction": "AGWSR Community School District (Butler, Franklin, Grundy, Hardin counties)",
   "ballotLanguage": "Shall the Board of Directors of the AGWSR Community School District in the Counties of Butler, Franklin, Grundy, and Hardin, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $10,820,000 to provide funds to remodel, repair, improve, and equip the high school, including science and family & consumer science classrooms and heating, ventilation, and air conditioning (HVAC), mechanical, plumbing, electrical, roofing, and site improvements; to build, furnish, and equip a multipurpose activities/recess facility, including site improvements; and to remodel, repair, improve, and equip the middle school locker rooms?"
  }
 ],
 "notes": "Source is the county's 'General Election - November 3, 2026 Butler County Candidate Filings' list (incumbent asterisks stripped from names). Supervisor seats listed by district (District 2, District 3) - voters see only their district. The filing list does not state vote-for/seat counts, so seats are null for nonpartisan offices; Soil and Water Conservation District Commissioner has no filed candidates (write-in only). No county hospital trustee race listed. The posted 'Sample Ballots for Website.pdf' is the June 2, 2026 primary sample ballot (not the general), so it was not used."
