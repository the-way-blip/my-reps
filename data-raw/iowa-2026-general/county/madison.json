 "measures": [
  {
   "name": "Interstate 35 Community School District Public Measure Z",
   "jurisdiction": "Interstate 35 Community School District (Clarke, Madison, Warren counties)",
   "ballotLanguage": "Shall the Board of Directors of the Interstate 35 Community School District in the Counties of Clarke, Madison, and Warren, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $12,300,000 to provide funds to remodel, repair, improve, and equip the school building, including reconfiguration of academic spaces, HVAC, mechanical and exterior improvements; to build, furnish, and equip athletic facilities, including a new stadium and track, parking, and site improvements, and for related improvements to repurpose the existing track and field, bleachers, and press box; and for site and access improvements to the school campus?"
  }
 ],
 "notes": "Sources: 'Madison County 2026 General Election-Final List of Races and Public Measures' PDF plus the combined 'Sample Ballots General Election 2026' PDF (parties taken from sample ballots). Supervisors are elected by district - voters see only their district (Districts 1 and 3 up in 2026). Township trustee races are vote-for-two; townships with no candidate filed are listed with empty candidate arrays. The races list PDF prints the bond amount as '$12,300,00' (typo); the sample ballot prints $12,300,000, used here. Public Measure Z appears only on I-35 CSD ballot styles."
}