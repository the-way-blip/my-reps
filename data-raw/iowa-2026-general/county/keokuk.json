 "measures": [
  {
   "name": "Public Measure ML (Keota Community School District GO Bond)",
   "jurisdiction": "Keota Community School District (5 Keokuk ballot styles)",
   "ballotLanguage": "Shall the Board of Directors of the Keota Community School District in the Counties of Keokuk and Washington, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $6,400,000 to provide funds to remodel, repair, equip, and improve the Jr-Sr High School, including a secure entrance, educational spaces, HVAC, mechanical, electrical, and plumbing improvements; to remodel, repair, equip, and improve the Elementary School, including a secure entrance and plumbing improvements; and for fire alarm upgrades throughout the school building?"
  },
  {
   "name": "Public Measure MN (Pekin Community School District GO Bond)",
   "jurisdiction": "Pekin Community School District (8 Keokuk ballot styles)",
   "ballotLanguage": "Shall the Board of Directors of the Pekin Community School District in the Counties of Jefferson, Keokuk, Wapello, and Washington, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $9,200,000 to provide funds to build, furnish, and equip additions to the school building, including classroom and commons area spaces; to remodel, repair, improve, and equip the school building, including a secure entrance, HVAC, mechanical, electrical, plumbing, parking, accessibility, and site improvements?"
  },
  {
   "name": "Public Measure NC (Kirkwood Community College GO Bond)",
   "jurisdiction": "Kirkwood Community College (Merged Area X) (6 Keokuk ballot styles)",
   "ballotLanguage": "Shall Kirkwood Community College (Merged Area X) in the Counties of Benton, Black Hawk, Buchanan, Cedar, Clinton, Delaware, Dubuque, Iowa, Jackson, Jefferson, Johnson, Jones, Keokuk, Linn, Louisa, Poweshiek, Tama, and Washington, be authorized to renovate, improve, erect, and equip facilities to modernize learning spaces with an emphasis on health sciences, industrial technologies, agricultural sciences, and business and information technology, contract indebtedness therefor, and issue General Obligation Bonds in an amount not exceeding $88,000,000 for those purposes?"
  }
 ],
 "notes": "Parsed from official per-precinct/township sample ballots (35 styles), consistent with the county candidate list. Board of Supervisors is at-large: 'Vote for no more than Two' appears on every ballot style countywide (candidate order rotates). Township trustee races are 'vote for no more than two' per township. Democratic 'No Candidate' for all county partisan offices. Empty candidate lists = 'No Candidate Filed' (write-in only). Hospital trustee race is the Keokuk County Hospital Trustee (vote for five, 11 candidates)."
