 "measures": [
  {
   "name": "Public Measure HK",
   "jurisdiction": "Fayette County",
   "ballotLanguage": "Shall the Fayette County Board of Supervisors, upon recommendation by the Fayette County EMS Advisory Council, be authorized to levy and impose an ad valorem, meaning according to value, property tax not to exceed seventy-five cents ($0.75) per one thousand dollars ($1,000) of assessed valuation on all taxable property within Fayette County for the purpose of funding Emergency Medical Services, for a period not to exceed fifteen (15) years?"
  },
  {
   "name": "Public Measure BW",
   "jurisdiction": "Sumner-Fredericksburg Community School District",
   "ballotLanguage": "Shall the Board of Directors of the Sumner-Fredericksburg Community School District in the Counties of Bremer, Chickasaw, and Fayette, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $16,300,000 to provide funds to construct, build, furnish, and equip additions to the High School building; and to remodel, repair, improve, and equip the existing High School, Middle School, and Fredericksburg Elementary buildings, including playground, parking, and site improvements?"
  }
 ],
 "notes": "Supervisors elected at-large ('Vote for no more than Two', identical on all 43 ballot styles). Sample ballots are scanned images; contests read via OCR with spot visual checks. Township trustee (vote for 2) and clerk (vote for 1) appear on township precinct ballots; empty candidate lists = office printed with write-in lines only. Fayette County EMS levy (HK) is countywide; Sumner-Fredericksburg CSD bond (BW) only on the 4 'Sumner Fred School' ballot styles. No hospital trustee contest."
}