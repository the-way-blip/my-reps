 "measures": [
  {
   "name": "Public Measure U - City Of Urbandale",
   "jurisdiction": "City Of Urbandale",
   "ballotLanguage": "Shall the City of Urbandale, State of Iowa, issue its General Obligation Bonds or Capital Loan Notes in an amount not exceeding the amount of $25,000,000 for the purpose of paying costs of designing, constructing, equipping, and furnishing a new police station, with related site improvements?"
  },
  {
   "name": "Public Measure BQ - Madrid Community School District",
   "jurisdiction": "Madrid Community School District",
   "ballotLanguage": "Shall the Board of Directors of the Madrid Community School District in the Counties of Boone, Dallas, and Polk, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $4,300,000 to provide funds to build, furnish and equip additions to its existing Junior-Senior High School, including a Career Academy addition, with related remodeling and improvements and site improvements?"
  },
  {
   "name": "Public Measure S - Saydel Community School District",
   "jurisdiction": "Saydel Community School District",
   "ballotLanguage": "Shall the Board of Directors of the Saydel Community School District in the County of Polk, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $26,900,000 to provide funds to build, furnish, and equip an addition to Cornell Elementary for kindergarten and early childhood education, including a playground and site improvements; to remodel, repair, furnish, and equip Cornell Elementary, Woodside Middle School, and the High School, including HVAC, electrical, and building improvements; for improvements to the High School emergency generator system and sewer line; and to remodel, repair, furnish, and equip athletic facilities, including improvements to the softball concession and restrooms facility, football field turf replacement, and softball and baseball field turf installation?"
  }
 ],
 "notes": "Parsed from all 201 per-precinct sample ballot PDFs linked on the Polk County Auditor's 2026 General Election voter-information page. Supervisors are elected by district (voters see only their own district): District 1 appears on 35 precinct ballots, District 4 on 42, District 5 on 34; Districts 2 and 3 are not on the ballot. Township trustee/clerk contests appear only on that township's precinct ballots; contests with empty candidate lists have no printed candidate (write-in only). Saylor Township Trustee is vote-for-two. Measures: Urbandale city measure U (12 Urbandale precincts), Saydel CSD measure S (7 precincts), Madrid CSD measure BQ (Madison 1 MAD and Sheldahl 1 MAD precincts). Names copied as printed (title case for office names only)."
}