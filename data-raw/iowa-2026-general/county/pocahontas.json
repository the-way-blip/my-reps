 "measures": [
  {
   "name": "Public Measure RQ - Pocahontas Area Community School District General Obligation Bonds",
   "jurisdiction": "Pocahontas Area Community School District",
   "ballotLanguage": "Shall the Board of Directors of the Pocahontas Area Community School District in the Counties of Pocahontas, Calhoun and Palo Alto, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $20,000,000 to provide funds to remodel, repair, improve, and equip the middle/high school and elementary school, including career and technical education and classroom spaces; to build, furnish, and equip additions to the middle/high school and elementary school, including site improvements; for playground improvements at the elementary school; and to build, furnish, and equip a central office and regional learning center building and a transportation facility, including site improvements?"
  }
 ],
 "notes": "Parsed from the auditor's 88-page sample ballot PDF (44 precinct/ballot styles). Supervisors are elected by district: District 2 appears only on the Laurens and Swan Lake Township styles, District 4 only on 14 styles in that district. Township offices appear only on that township's ballot styles; contests with empty candidates are write-in only. Cedar Township Trustee is printed as 'Vote for no more than One' with two candidates, and Cedar Township Trustee To Fill a Vacancy as 'Vote for no more than Two' (Hanna Davis appears in both the vacancy trustee and clerk contests) - copied as printed. Public Measure RQ appears on Pocahontas Area CSD styles only."
