 "measures": [
  {
   "name": "Knoxville Community School District Public Measure ON",
   "jurisdiction": "Knoxville Community School District (Marion County)",
   "ballotLanguage": "Shall the Board of Directors of the Knoxville Community School District in the County of Marion, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $15,300,000 to provide funds to build, furnish, and equip a new elementary building on the Veterans District Site, including related site improvements?"
  },
  {
   "name": "PCM Community School District Public Measure LL",
   "jurisdiction": "PCM Community School District (Jasper, Polk, Marion counties)",
   "ballotLanguage": "Shall the Board of Directors of the PCM Community School District in the Counties of Jasper, Polk, and Marion, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $14,195,000 to provide funds to remodel, repair, improve, and equip the Monroe campus, including classroom and career and technical education spaces; to build, furnish, and equip an addition to the Monroe campus, including a multipurpose performance gymnasium, support spaces, and site improvements; and to improve the Prairie City campus site, including playgrounds and parking?"
  }
 ],
 "notes": "Source: 34 official precinct sample ballot PDFs (text-based). Supervisors: a single 'County Board of Supervisors' vote-for-one race with the same candidate appears on all 34 ballot styles = at-large. Township trustee races are vote-for-one. Dallas Township (trustee and clerk) and Liberty Township trustee have no printed candidates. Public Measure ON appears on the KSD (Knoxville CSD) ballot styles; Public Measure LL on the PCM ballot styles (RR Twp - PCM, Summit Twp - PCM)."
}