s":"candidate"}]},{"id":"ia-poweshiek-washington-township-trustee-27","office":"Washington Township Trustee","category":"Washington Township Trustee","level":"Township","scope":"township","area":"Washington","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":527,"candidates":[{"name":"Jordan Harms","party":null,"status":"candidate"}]},{"id":"ia-poweshiek-washington-township-clerk-28","office":"Washington Township Clerk","category":"Washington Township Clerk","level":"Township","scope":"township","area":"Washington","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":528,"candidates":[{"name":"Peter Schalmo","party":null,"status":"candidate"}]},{"id":"ia-poweshiek-jackson-township-trustee-29","office":"Jackson Township Trustee","category":"Jackson Township Trustee","level":"Township","scope":"township","area":"Jackson","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":529,"candidates":[{"name":"Mike Phillips","party":null,"status":"candidate"}]},{"id":"ia-poweshiek-jackson-township-clerk-30","office":"Jackson Township Clerk","category":"Jackson Township Clerk","level":"Township","scope":"township","area":"Jackson","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":530,"candidates":[{"name":"Donald J. Armstrong","party":null,"status":"candidate"}]},{"id":"ia-poweshiek-scott-township-trustee-31","office":"Scott Township Trustee","category":"Scott Township Trustee","level":"Township","scope":"township","area":"Scott","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":531,"candidates":[{"name":"Jessica Lacaeyse","party":null,"status":"candidate"}]},{"id":"ia-poweshiek-scott-township-trustee-to-fill-vacancy-32","office":"Scott Township Trustee - To Fill Vacancy","category":"Scott Township Trustee - To Fill Vacancy","level":"Township","scope":"township","area":"Scott","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":532,"candidates":[{"name":"Joel Lacaeyse","party":null,"status":"candidate"}]},{"id":"ia-poweshiek-scott-township-clerk-33","office":"Scott Township Clerk","category":"Scott Township Clerk","level":"Township","scope":"township","area":"Scott","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":533,"candidates":[{"name":"Stacy Helm","party":null,"status":"candidate"}]}],"referendums":[{"id":"ia-amendment-1","name":"Statewide Public Measure 1 — Requirements for Certain State Tax Law Changes","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the following amendment to the Constitution be adopted?\n\nProvides that any bill to increase the individual income tax rate or the corporate income tax rate, or the rate of any other type of tax based upon income or legal and special reserves, shall require the affirmative votes of at least two-thirds of the members elected to each house of the legislature for passage. Further, the two-thirds majority vote requirement applies to the passage of a bill to establish a new tax on any type of income or legal and special reserves imposed by the state. The requirement excludes taxes imposed at the option of a local government. A lawsuit challenging the proper enactment of a bill under this section must be filed no later than one year following the enactment.\n\nThe Constitution of the State of Iowa is amended by adding the following new section to new Article XIII: Passage of a bill that increases the individual income tax rate or the corporate income tax rate, or the rate of any other type of tax based upon income or legal and special reserves, shall require the affirmative votes of at least two-thirds of the members elected to each house of the general assembly. This requirement does not apply to taxes imposed at the option of a local government. Passage of a bill that establishes a new tax on any type of income or legal and special reserves imposed by the state shall require the affirmative votes of at least two-thirds of the members elected to each house of the general assembly. A lawsuit challenging the proper enactment of a bill under this section must be filed no later than one year following the enactment. If such a lawsuit is not filed within the one-year limit, the bill shall be considered properly enacted under this section. Each bill to which this section applies must include a separate provision describing the requirements for enactment prescribed by this section. The general assembly shall enact laws to implement this section."},{"id":"ia-retain-john-m-sandy","name":"Retain Court of Appeals Judge John M. Sandy?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall John M. Sandy, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-julie-a-schumacher","name":"Retain Court of Appeals Judge Julie A. Schumacher?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Julie A. Schumacher, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-sharon-soorholtz-greer","name":"Retain Court of Appeals Judge Sharon Soorholtz Greer?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Sharon Soorholtz Greer, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-susan-cole","name":"Retain District Associate Judge Susan Cole? (District 8A)","type":"District Associate Judge Retention","statewide":false,"ballotLanguage":"Shall Susan Cole, District Associate judge (Judicial Election District 8A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-dustin-hite","name":"Retain District Court Judge Dustin Hite? (District 8A)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Dustin Hite, District Court judge (Judicial Election District 8A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-jennifer-nicole-jensen","name":"Retain District Associate Judge Jennifer Nicole Jensen? (District 8A)","type":"District Associate Judge Retention","statewide":false,"ballotLanguage":"Shall Jennifer Nicole Jensen, District Associate judge (Judicial Election District 8A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-amber-l-thompson","name":"Retain District Court Judge Amber L. Thompson? (District 8A)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Amber L. Thompson, District Court judge (Judicial Election District 8A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-poweshiek-q-0","name":"Kirkwood Community College Public Measure NC","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall the following public measure be adopted? \"Shall Kirkwood Community College (Merged Area X) in the Counties of Benton, Black Hawk, Buchanan, Cedar, Clinton, Delaware, Dubuque, Iowa, Jackson, Jefferson, Johnson, Jones, Keokuk, Linn, Louisa, Poweshiek, Tama, and Washington, be authorized to renovate, improve, erect, and equip facilities to modernize learning spaces with an emphasis on health sciences, industrial technologies, agricultural sciences, and business and information technology, contract indebtedness therefor, and issue General Obligation Bonds in an amount not exceeding $88,000,000 for those purposes?\""}]}