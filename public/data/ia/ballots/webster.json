":true,"ballotOrder":545,"candidates":[{"name":"Dana Housken","party":null,"status":"candidate"}]},{"id":"ia-webster-yell-township-trustee-46","office":"Yell Township Trustee","category":"Yell Township Trustee","level":"Township","scope":"township","area":"Yell","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":546,"candidates":[{"name":"Troy Ferrari","party":null,"status":"candidate"}]},{"id":"ia-webster-yell-township-clerk-47","office":"Yell Township Clerk","category":"Yell Township Clerk","level":"Township","scope":"township","area":"Yell","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":547,"candidates":[{"name":"Lori Ferrari","party":null,"status":"candidate"}]}],"referendums":[{"id":"ia-amendment-1","name":"Statewide Public Measure 1 — Requirements for Certain State Tax Law Changes","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the following amendment to the Constitution be adopted?\n\nProvides that any bill to increase the individual income tax rate or the corporate income tax rate, or the rate of any other type of tax based upon income or legal and special reserves, shall require the affirmative votes of at least two-thirds of the members elected to each house of the legislature for passage. Further, the two-thirds majority vote requirement applies to the passage of a bill to establish a new tax on any type of income or legal and special reserves imposed by the state. The requirement excludes taxes imposed at the option of a local government. A lawsuit challenging the proper enactment of a bill under this section must be filed no later than one year following the enactment.\n\nThe Constitution of the State of Iowa is amended by adding the following new section to new Article XIII: Passage of a bill that increases the individual income tax rate or the corporate income tax rate, or the rate of any other type of tax based upon income or legal and special reserves, shall require the affirmative votes of at least two-thirds of the members elected to each house of the general assembly. This requirement does not apply to taxes imposed at the option of a local government. Passage of a bill that establishes a new tax on any type of income or legal and special reserves imposed by the state shall require the affirmative votes of at least two-thirds of the members elected to each house of the general assembly. A lawsuit challenging the proper enactment of a bill under this section must be filed no later than one year following the enactment. If such a lawsuit is not filed within the one-year limit, the bill shall be considered properly enacted under this section. Each bill to which this section applies must include a separate provision describing the requirements for enactment prescribed by this section. The general assembly shall enact laws to implement this section."},{"id":"ia-retain-john-m-sandy","name":"Retain Court of Appeals Judge John M. Sandy?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall John M. Sandy, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-julie-a-schumacher","name":"Retain Court of Appeals Judge Julie A. Schumacher?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Julie A. Schumacher, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-sharon-soorholtz-greer","name":"Retain Court of Appeals Judge Sharon Soorholtz Greer?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Sharon Soorholtz Greer, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-bethany-j-currie","name":"Retain District Court Judge Bethany J. Currie? (District 2B)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Bethany J. Currie, District Court judge (Judicial Election District 2B), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-angela-l-doyle","name":"Retain District Court Judge Angela L. Doyle? (District 2B)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Angela L. Doyle, District Court judge (Judicial Election District 2B), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-amy-moore","name":"Retain District Court Judge Amy Moore? (District 2B)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Amy Moore, District Court judge (Judicial Election District 2B), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-stephen-a-owen","name":"Retain District Associate Judge Stephen A. Owen? (District 2B)","type":"District Associate Judge Retention","statewide":false,"ballotLanguage":"Shall Stephen A. Owen, District Associate judge (Judicial Election District 2B), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-christopher-polking","name":"Retain District Court Judge Christopher Polking? (District 2B)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Christopher Polking, District Court judge (Judicial Election District 2B), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-ashley-sparks","name":"Retain District Court Judge Ashley Sparks? (District 2B)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Ashley Sparks, District Court judge (Judicial Election District 2B), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-joseph-l-tofilon","name":"Retain District Associate Judge Joseph L. Tofilon? (District 2B)","type":"District Associate Judge Retention","state