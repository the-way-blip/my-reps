","category":"Spring Creek Township Clerk","level":"Township","scope":"township","area":"Spring Creek","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":536,"candidates":[{"name":"Susan M Davis","party":null,"status":"candidate"}]},{"id":"ia-black-hawk-union-township-trustee-37","office":"Union Township Trustee","category":"Union Township Trustee","level":"Township","scope":"township","area":"Union","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":537,"candidates":[{"name":"Tammy L Stevenson-Wenzel","party":null,"status":"candidate"}]},{"id":"ia-black-hawk-union-township-clerk-38","office":"Union Township Clerk","category":"Union Township Clerk","level":"Township","scope":"township","area":"Union","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":538,"candidates":[{"name":"Bonnie L Stevenson","party":null,"status":"candidate"}]},{"id":"ia-black-hawk-washington-township-trustee-39","office":"Washington Township Trustee","category":"Washington Township Trustee","level":"Township","scope":"township","area":"Washington","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":539,"candidates":[{"name":"Mark Dayton","party":null,"status":"candidate"}]},{"id":"ia-black-hawk-washington-township-clerk-40","office":"Washington Township Clerk","category":"Washington Township Clerk","level":"Township","scope":"township","area":"Washington","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":540,"candidates":[{"name":"William H Hesse","party":null,"status":"candidate"}]}],"referendums":[{"id":"ia-amendment-1","name":"Statewide Public Measure 1 — Requirements for Certain State Tax Law Changes","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the following amendment to the Constitution be adopted?\n\nProvides that any bill to increase the individual income tax rate or the corporate income tax rate, or the rate of any other type of tax based upon income or legal and special reserves, shall require the affirmative votes of at least two-thirds of the members elected to each house of the legislature for passage. Further, the two-thirds majority vote requirement applies to the passage of a bill to establish a new tax on any type of income or legal and special reserves imposed by the state. The requirement excludes taxes imposed at the option of a local government. A lawsuit challenging the proper enactment of a bill under this section must be filed no later than one year following the enactment.\n\nThe Constitution of the State of Iowa is amended by adding the following new section to new Article XIII: Passage of a bill that increases the individual income tax rate or the corporate income tax rate, or the rate of any other type of tax based upon income or legal and special reserves, shall require the affirmative votes of at least two-thirds of the members elected to each house of the general assembly. This requirement does not apply to taxes imposed at the option of a local government. Passage of a bill that establishes a new tax on any type of income or legal and special reserves imposed by the state shall require the affirmative votes of at least two-thirds of the members elected to each house of the general assembly. A lawsuit challenging the proper enactment of a bill under this section must be filed no later than one year following the enactment. If such a lawsuit is not filed within the one-year limit, the bill shall be considered properly enacted under this section. Each bill to which this section applies must include a separate provision describing the requirements for enactment prescribed by this section. The general assembly shall enact laws to implement this section."},{"id":"ia-retain-john-m-sandy","name":"Retain Court of Appeals Judge John M. Sandy?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall John M. Sandy, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-julie-a-schumacher","name":"Retain Court of Appeals Judge Julie A. Schumacher?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Julie A. Schumacher, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-sharon-soorholtz-greer","name":"Retain Court of Appeals Judge Sharon Soorholtz Greer?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Sharon Soorholtz Greer, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-joel-a-dalrymple","name":"Retain District Court Judge Joel A. Dalrymple? (District 1B)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Joel A. Dalrymple, District Court judge (Judicial Election District 1B), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-patrice-jaye-eichman","name":"Retain District Associate Judge Patrice Jaye Eichman? (District 1B)","type":"District Associate Judge Retention","statewide":false,"ballotLanguage":"Shall Patrice Jaye Eichman, District Associate judge (Judicial Election District 1B), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-michelle-jungers","name":"Retain District Associate Judge Michelle Jungers? (District 1B)","type":"District Associate Judge Retention","statewide":false,"ballotLanguage":"Shall Michelle Jungers, District Associate judge (Judicial Election District 1B), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-linnea-m-n-nicol","name":"Retain District Associate Judge Linnea M.N. Nicol? (District 1B)","type":"District Associate Judge Retention","statewide":false,"ballotLanguage":"Shall Linnea M.N. Nicol, District Associate judge (Judicial Election District 1B), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-black-hawk-q-0","name":"Public Measure NC","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall Kirkwood Community College (Merged Area X) in the Counties of Benton, Black Hawk, Buchanan, Cedar, Clinton, Delaware, Dubuque, Iowa, Jackson, Jefferson, Johnson, Jones, Keokuk, Linn, Louisa, Poweshiek, Tama, and Washington, be authorized to renovate, improve, erect, and equip facilities to modernize learning spaces with an emphasis on health sciences, industrial technologies, agricultural sciences, and business and information technology, contract indebtedness therefor, and issue General Obligation Bonds in an amount not exceeding $88,000,000 for those purposes?"}]}