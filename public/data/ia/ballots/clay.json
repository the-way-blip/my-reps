rty":null,"status":"candidate"}]},{"id":"ia-clay-sioux-township-trustee-28","office":"Sioux Township Trustee","category":"Sioux Township Trustee","level":"Township","scope":"township","area":"Sioux","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":528,"candidates":[{"name":"Beverly Hummel","party":null,"status":"candidate"}]},{"id":"ia-clay-sioux-township-clerk-29","office":"Sioux Township Clerk","category":"Sioux Township Clerk","level":"Township","scope":"township","area":"Sioux","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":529,"candidates":[{"name":"Bev Salton Dudziak","party":null,"status":"candidate"}]},{"id":"ia-clay-waterford-township-trustee-30","office":"Waterford Township Trustee","category":"Waterford Township Trustee","level":"Township","scope":"township","area":"Waterford","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":530,"candidates":[{"name":"Jay Pearson","party":null,"status":"candidate"}]},{"id":"ia-clay-waterford-township-clerk-31","office":"Waterford Township Clerk","category":"Waterford Township Clerk","level":"Township","scope":"township","area":"Waterford","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":531,"candidates":[{"name":"Debra Jessen","party":null,"status":"candidate"}]}],"referendums":[{"id":"ia-amendment-1","name":"Statewide Public Measure 1 — Requirements for Certain State Tax Law Changes","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the following amendment to the Constitution be adopted?\n\nProvides that any bill to increase the individual income tax rate or the corporate income tax rate, or the rate of any other type of tax based upon income or legal and special reserves, shall require the affirmative votes of at least two-thirds of the members elected to each house of the legislature for passage. Further, the two-thirds majority vote requirement applies to the passage of a bill to establish a new tax on any type of income or legal and special reserves imposed by the state. The requirement excludes taxes imposed at the option of a local government. A lawsuit challenging the proper enactment of a bill under this section must be filed no later than one year following the enactment.\n\nThe Constitution of the State of Iowa is amended by adding the following new section to new Article XIII: Passage of a bill that increases the individual income tax rate or the corporate income tax rate, or the rate of any other type of tax based upon income or legal and special reserves, shall require the affirmative votes of at least two-thirds of the members elected to each house of the general assembly. This requirement does not apply to taxes imposed at the option of a local government. Passage of a bill that establishes a new tax on any type of income or legal and special reserves imposed by the state shall require the affirmative votes of at least two-thirds of the members elected to each house of the general assembly. A lawsuit challenging the proper enactment of a bill under this section must be filed no later than one year following the enactment. If such a lawsuit is not filed within the one-year limit, the bill shall be considered properly enacted under this section. Each bill to which this section applies must include a separate provision describing the requirements for enactment prescribed by this section. The general assembly shall enact laws to implement this section."},{"id":"ia-retain-john-m-sandy","name":"Retain Court of Appeals Judge John M. Sandy?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall John M. Sandy, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-julie-a-schumacher","name":"Retain Court of Appeals Judge Julie A. Schumacher?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Julie A. Schumacher, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-sharon-soorholtz-greer","name":"Retain Court of Appeals Judge Sharon Soorholtz Greer?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Sharon Soorholtz Greer, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-charles-k-borth","name":"Retain District Court Judge Charles K. Borth? (District 3A)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Charles K. Borth, District Court judge (Judicial Election District 3A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-kristi-busse","name":"Retain District Associate Judge Kristi Busse? (District 3A)","type":"District Associate Judge Retention","statewide":false,"ballotLanguage":"Shall Kristi Busse, District Associate judge (Judicial Election District 3A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-jennifer-bennett-finn","name":"Retain District Associate Judge Jennifer Bennett Finn? (District 3A)","type":"District Associate Judge Retention","statewide":false,"ballotLanguage":"Shall Jennifer Bennett Finn, District Associate judge (Judicial Election District 3A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-adam-miller","name":"Retain District Court Judge Adam Miller? (District 3A)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Adam Miller, District Court judge (Judicial Election District 3A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-carl-j-petersen","name":"Retain District Court Judge Carl J. Petersen? (District 3A)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Carl J. Petersen, District Court judge (Judicial Election District 3A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-andrew-smith","name":"Retain District Court Judge Andrew Smith? (District 3A)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Andrew Smith, District Court judge (Judicial Election District 3A), be retained in office? Vote YES to keep the judge or NO to remove the judge."}]}