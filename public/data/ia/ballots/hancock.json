,{"id":"ia-hancock-orthel-township-trustee-31","office":"Orthel Township Trustee","category":"Orthel Township Trustee","level":"Township","scope":"township","area":"Orthel","seats":2,"type":"nonpartisan","description":"Vote for up to 2.","cityMaybe":true,"ballotOrder":531,"candidates":[{"name":"Kenneth DeWaard","party":null,"status":"candidate"}]},{"id":"ia-hancock-orthel-township-clerk-32","office":"Orthel Township Clerk","category":"Orthel Township Clerk","level":"Township","scope":"township","area":"Orthel","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":532,"candidates":[{"name":"Steve Kelly","party":null,"status":"candidate"}]},{"id":"ia-hancock-twin-lake-township-clerk-33","office":"Twin Lake Township Clerk","category":"Twin Lake Township Clerk","level":"Township","scope":"township","area":"Twin Lake","seats":1,"type":"nonpartisan","description":"","cityMaybe":true,"ballotOrder":533,"candidates":[{"name":"Timothy J. Landgraf","party":null,"status":"candidate"}]}],"referendums":[{"id":"ia-amendment-1","name":"Statewide Public Measure 1 — Requirements for Certain State Tax Law Changes","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the following amendment to the Constitution be adopted?\n\nProvides that any bill to increase the individual income tax rate or the corporate income tax rate, or the rate of any other type of tax based upon income or legal and special reserves, shall require the affirmative votes of at least two-thirds of the members elected to each house of the legislature for passage. Further, the two-thirds majority vote requirement applies to the passage of a bill to establish a new tax on any type of income or legal and special reserves imposed by the state. The requirement excludes taxes imposed at the option of a local government. A lawsuit challenging the proper enactment of a bill under this section must be filed no later than one year following the enactment.\n\nThe Constitution of the State of Iowa is amended by adding the following new section to new Article XIII: Passage of a bill that increases the individual income tax rate or the corporate income tax rate, or the rate of any other type of tax based upon income or legal and special reserves, shall require the affirmative votes of at least two-thirds of the members elected to each house of the general assembly. This requirement does not apply to taxes imposed at the option of a local government. Passage of a bill that establishes a new tax on any type of income or legal and special reserves imposed by the state shall require the affirmative votes of at least two-thirds of the members elected to each house of the general assembly. A lawsuit challenging the proper enactment of a bill under this section must be filed no later than one year following the enactment. If such a lawsuit is not filed within the one-year limit, the bill shall be considered properly enacted under this section. Each bill to which this section applies must include a separate provision describing the requirements for enactment prescribed by this section. The general assembly shall enact laws to implement this section."},{"id":"ia-retain-john-m-sandy","name":"Retain Court of Appeals Judge John M. Sandy?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall John M. Sandy, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-julie-a-schumacher","name":"Retain Court of Appeals Judge Julie A. Schumacher?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Julie A. Schumacher, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-sharon-soorholtz-greer","name":"Retain Court of Appeals Judge Sharon Soorholtz Greer?","type":"Court of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Sharon Soorholtz Greer, Court of Appeals judge, be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-christopher-foy","name":"Retain District Court Judge Christopher Foy? (District 2A)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Christopher Foy, District Court judge (Judicial Election District 2A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-karen-kaufman-salic","name":"Retain District Associate Judge Karen Kaufman Salic? (District 2A)","type":"District Associate Judge Retention","statewide":false,"ballotLanguage":"Shall Karen Kaufman Salic, District Associate judge (Judicial Election District 2A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-mark-milder","name":"Retain District Associate Judge Mark Milder? (District 2A)","type":"District Associate Judge Retention","statewide":false,"ballotLanguage":"Shall Mark Milder, District Associate judge (Judicial Election District 2A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-gregg-r-rosenbladt","name":"Retain District Court Judge Gregg R. Rosenbladt? (District 2A)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Gregg R. Rosenbladt, District Court judge (Judicial Election District 2A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-adam-sauer","name":"Retain District Associate Judge Adam Sauer? (District 2A)","type":"District Associate Judge Retention","statewide":false,"ballotLanguage":"Shall Adam Sauer, District Associate judge (Judicial Election District 2A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-dedra-schroeder","name":"Retain District Court Judge DeDra Schroeder? (District 2A)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall DeDra Schroeder, District Court judge (Judicial Election District 2A), be retained in office? Vote YES to keep the judge or NO to remove the judge."},{"id":"ia-retain-colleen-d-weiland","name":"Retain District Court Judge Colleen D. Weiland? (District 2A)","type":"District Court Judge Retention","statewide":false,"ballotLanguage":"Shall Colleen D. Weiland, District Court judge (Judicial Election District 2A), be retained in office? Vote YES to keep the judge or NO to remove the judge."}]}