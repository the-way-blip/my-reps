,"maybe":true}],"referendums":[{"id":"mn-amendment-1","name":"CONSTITUTIONAL AMENDMENT 1: Increasing funding to school districts","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the Minnesota Constitution be amended to increase the funding going to all school districts from the permanent school fund, which is a fund that supports school districts without raising individual income or property taxes, effective July 1, 2027?"},{"id":"mn-stevens-43846-township-question-1-moore-twp","name":"TOWNSHIP QUESTION 1 (Moore Twp): Appointment of Town Clerk and Town Treasurer","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall Option B, providing for the appointment of town clerk and town treasurer by the town board, be adopted by Moore Township?","mcds":["43846"]},{"id":"mn-stevens-sd0264-school-district-question-1-isd-264","name":"SCHOOL DISTRICT QUESTION 1 (ISD #264): Changing Authorized Use of Bond Proceeds","type":"Local Public Question","statewide":false,"ballotLanguage":"The school board of Independent School District No. 264 (Herman-Norcross) has proposed to use approximately $800,000 of any remaining proceeds of the School Districts General Obligation Facilities Maintenance Bonds, Series 2023A, originally issued to fund the costs of certain improvements included in the School Districts facilities maintenance plan approved by the school board and the Commissioner of Education which have since been completed, to fund the acquisition and betterment of school sites and facilities, including the completion of various deferred maintenance projects at school sites and facilities.\n\nShall the school board of Independent School District No. 264 (Herman-Norcross) be authorized to use approximately $800,000 of any remaining proceeds of its General Obligation Facilities Maintenance Bonds, Series 2023A, to fund the acquisition and betterment of school sites and facilities?","schoolNum":"0264","area":"Herman-Norcross"},{"id":"mn-stevens-sd2342-school-district-question-1-isd-2342","name":"SCHOOL DISTRICT QUESTION 1 (ISD #2342): Approval of School District Bond Issue","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall the school board of Independent School District No. 2342 (West Central Area Schools) be authorized to issue its general obligation school building bonds in an amount not to exceed $33,805,000 to provide funds for the acquisition and betterment of school sites and facilities, including the construction and equipping of an elementary school addition^ renovations and upgrades to science rooms and career and technical education (CTE) spaces^ deferred maintenance^ remodeling and updates to special education classrooms^ the construction of softball fields, a track, fitness center and playground improvements^ and the completion of water retention, grading and utility improvements to the school site and facility?","schoolNum":"2342","area":"West Central Area"}]}