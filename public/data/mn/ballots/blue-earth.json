ategory":"School Board Member (ISD #2860) (Elect 4)","seats":4,"type":"nonpartisan","description":"","ballotOrder":5000,"candidates":[{"name":"Brice Hanson","party":null,"status":"candidate"},{"name":"Matthew Zbaracki","party":null,"status":"candidate"},{"name":"Nate Eitzmann","party":null,"status":"candidate"},{"name":"Kyle Zierke","party":null,"status":"candidate"},{"name":"Mark Franta","party":null,"status":"candidate"}],"scope":"school","level":"School","area":"Blue Earth Area","schoolNum":"2860"}],"referendums":[{"id":"mn-amendment-1","name":"CONSTITUTIONAL AMENDMENT 1: Increasing funding to school districts","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the Minnesota Constitution be amended to increase the funding going to all school districts from the permanent school fund, which is a fund that supports school districts without raising individual income or property taxes, effective July 1, 2027?"},{"id":"mn-blue-earth-sd2071-school-district-question-1-isd-2071","name":"SCHOOL DISTRICT QUESTION 1 (ISD #2071): Approval of School District Referendum Revenue Authorization","type":"Local Public Question","statewide":false,"ballotLanguage":"The school board of Independent School District No. 2071 (Lake Crystal Wellcome Memorial) has proposed to increase its general education revenue by $391 per pupil. The proposed referendum revenue authorization would be applicable for ten years beginning with taxes payable in 2027, and increase each year by the rate of inflation beginning with taxes payable in 2028, unless otherwise revoked or reduced as provided by law.\n\nShall the increase in the revenue proposed by the school board of Independent School District No. 2071 be approved?\n\nBY VOTING \"YES\" ON THIS BALLOT QUESTION, YOU ARE VOTING FOR A PROPERTY TAX INCREASE.","schoolNum":"2071","area":"Lake Crystal-Wellcome Memorial"}]}