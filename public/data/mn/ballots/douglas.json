"level":"School","area":"Parkers Prairie","schoolNum":"0547"},{"id":"mn-douglas-sd2149-school-board-member-isd-2149-elect-3","office":"School Board Member (ISD #2149) (Elect 3)","category":"School Board Member (ISD #2149) (Elect 3)","seats":3,"type":"nonpartisan","description":"","ballotOrder":5000,"candidates":[{"name":"Bill Mills","party":null,"status":"candidate"},{"name":"Kemma Wing","party":null,"status":"candidate"},{"name":"Ted Reichmann","party":null,"status":"candidate"},{"name":"Kayla Nelson","party":null,"status":"candidate"},{"name":"Meagan Jensen","party":null,"status":"candidate"},{"name":"Jon Recker","party":null,"status":"candidate"},{"name":"Zachery Lagred","party":null,"status":"candidate"}],"scope":"school","level":"School","area":"Minnewaska","schoolNum":"2149"},{"id":"mn-douglas-sd2342-school-board-member-isd-2342-elect-3","office":"School Board Member (ISD #2342) (Elect 3)","category":"School Board Member (ISD #2342) (Elect 3)","seats":3,"type":"nonpartisan","description":"","ballotOrder":5000,"candidates":[{"name":"Ryan Saurer","party":null,"status":"candidate"},{"name":"Chris Anderson","party":null,"status":"candidate"},{"name":"Joshua Ulrich","party":null,"status":"candidate"}],"scope":"school","level":"School","area":"West Central Area","schoolNum":"2342"},{"id":"mn-douglas-sd2908-school-board-member-at-large-isd-2908-elect-3","office":"School Board Member At Large (ISD #2908) (Elect 3)","category":"School Board Member At Large (ISD #2908) (Elect 3)","seats":3,"type":"nonpartisan","description":"","ballotOrder":5000,"candidates":[{"name":"Jana Anderson","party":null,"status":"candidate"},{"name":"Jaci Stepan","party":null,"status":"candidate"}],"scope":"school","level":"School","area":"Brandon-Evansville","schoolNum":"2908"}],"referendums":[{"id":"mn-amendment-1","name":"CONSTITUTIONAL AMENDMENT 1: Increasing funding to school districts","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the Minnesota Constitution be amended to increase the funding going to all school districts from the permanent school fund, which is a fund that supports school districts without raising individual income or property taxes, effective July 1, 2027?"},{"id":"mn-douglas-09982-township-question-1-carlos-twp","name":"TOWNSHIP QUESTION 1 (Carlos Twp): Issuance of General Obligation Bonds for A Firehall","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall the Town of Carlos, Minnesota, be authorized to issue its general obligation bonds, including any bonds issued to refund such bonds, in an amount not-to-exceed $2,800,000, to provide funds for the acquisition, construction, and betterment of a firehall facility?\n\nBY VOTING \"YES\" ON THIS BALLOT QUESTION, YOU ARE VOTING FOR A PROPERTY TAX INCREASE.  [The City of Carlos, Minnesota (\"Carlos\"), and the Town of Belle River, Minnesota (\"Belle River\"), are obligated to contribute a pro rata share of the costs of the acquisition, construction, and betterment of a firehall facility (the \"Project\"), including, without limitation, a pro rata portion of the debt service on any bonds issued therefor, pursuant to the \"Cost Sharing Formula\" established by the Joint Powers Agreement (the \"Agreement\"), dated June 13, 2024, by and between the Town of Carlos, Minnesota (the \"Town\"), Belle River, and Carlos, as the same may be amended from time to time. Such revenues from Carlos and Belle River shall be a source of payment for the bonds, and the Towns property taxes will only increase in an amount sufficient to pay principal and interest on the bonds when due for the Towns portion, pursuant to the \"Cost Sharing Formula\" in the Agreement.]","mcds":["09982"]},{"id":"mn-douglas-sd0206-school-district-question-1-isd-206","name":"SCHOOL DISTRICT QUESTION 1 (ISD #206): Revoking Existing Referendum Revenue Authorization^ Approving New Authorization","type":"Local Public Question","statewide":false,"ballotLanguage":"The board of Independent School District No. 206 (Alexandria), Minnesota has proposed to revoke the School District's existing referendum revenue authorization of $595 per pupil and to replace that authorization with a new authorization of $2,225 per pupil, subject to an annual increase at the rate of inflation. The proposed referendum revenue authorization would be first levied in 2026 for taxes payable in 2027 and applicable for ten (10) years unless otherwise revoked or reduced as provided by law.\n\nShall the revocation of the existing referendum authorization and the approval of the new authorization proposed by the board of Independent School District No. 206 (Alexandria), Minnesota be approved?","schoolNum":"0206","area":"Alexandria"},{"id":"mn-douglas-sd2342-school-district-question-1-isd-2342","name":"SCHOOL DISTRICT QUESTION 1 (ISD #2342): Approval of School District Bond Issue","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall the school board of Independent School District No. 2342 (West Central Area Schools) be authorized to issue its general obligation school building bonds in an amount not to exceed $33,805,000 to provide funds for the acquisition and betterment of school sites and facilities, including the construction and equipping of an elementary school addition^ renovations and upgrades to science rooms and career and technical education (CTE) spaces^ deferred maintenance^ remodeling and updates to special education classrooms^ the construction of softball fields, a track, fitness center and playground improvements^ and the completion of water retention, grading and utility improvements to the school site and facility?","schoolNum":"2342","area":"West Central Area"}]}