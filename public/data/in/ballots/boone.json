id":"in-boone-3603","officeId":"3603","office":"Sheridan School Board, At Large (Hamilton, Boone)","category":"School Board Member","level":"School Board","scope":"school","area":"Sheridan","seats":1,"type":"nonpartisan","description":"","ballotOrder":420,"candidates":[{"name":"Nancy Boone","party":null,"status":"candidate"}]},{"id":"in-boone-1786","officeId":"1786","office":"Western Boone Community School Board, Clinton","category":"School Board Member","level":"School Board","scope":"school","area":"Western Boone Community","seats":1,"type":"nonpartisan","description":"","ballotOrder":420,"candidates":[{"name":"Shane Steimel","party":null,"status":"candidate"}]},{"id":"in-boone-3598","officeId":"3598","office":"Western Boone Community School Board, Harrison","category":"School Board Member","level":"School Board","scope":"school","area":"Western Boone Community","seats":1,"type":"partisan","description":"","ballotOrder":420,"candidates":[{"name":"Melissa Smith","party":"republican","status":"candidate"}]},{"id":"in-boone-3650","officeId":"3650","office":"Western Boone Community School Board, Jackson","category":"School Board Member","level":"School Board","scope":"school","area":"Western Boone Community","seats":1,"type":"partisan","description":"","ballotOrder":420,"candidates":[{"name":"Phillip Foster","party":"republican","status":"candidate"}]},{"id":"in-boone-3194","officeId":"3194","office":"Western Boone Community School Board, Sugar Creek","category":"School Board Member","level":"School Board","scope":"school","area":"Western Boone Community","seats":1,"type":"nonpartisan","description":"","ballotOrder":420,"candidates":[{"name":"Dennis J Reagan","party":null,"status":"candidate"}]},{"id":"in-boone-1034","officeId":"1034","office":"Zionsville Community School Board, At Large","category":"School Board Member","level":"School Board","scope":"school","area":"Zionsville Community","seats":1,"type":"partisan","description":"","ballotOrder":420,"candidates":[{"name":"Thomas (Tom) Trupe","party":"republican","status":"candidate"},{"name":"Christina Wessel-Powell","party":null,"status":"candidate"}]},{"id":"in-boone-5292","officeId":"5292","office":"Zionsville Community School Board, Eagle","category":"School Board Member","level":"School Board","scope":"school","area":"Zionsville Community","seats":1,"type":"partisan","description":"","ballotOrder":420,"candidates":[{"name":"Melissa Waters","party":"republican","status":"candidate"},{"name":"Michael Berg","party":null,"status":"candidate"}]},{"id":"in-boone-4251","officeId":"4251","office":"Zionsville Community School Board, Union","category":"School Board Member","level":"School Board","scope":"school","area":"Zionsville Community","seats":1,"type":"partisan","description":"","ballotOrder":420,"candidates":[{"name":"Rachel Brandli","party":"republican","status":"candidate"},{"name":"Jennifer Valentine","party":null,"status":"candidate"}]}],"referendums":[{"id":"in-boone-q-public-question-1","name":"Public Question #1","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Currently, under the Constitution of the State of Indiana, a person charged with murder or treason is not entitled to be released on bail if the proof is evident or the presumption strong. Shall the Constitution of the State of Indiana be amended to provide that a person charged with an offense other than murder or treason is not entitled to bail if:\n(1) the proof is evident or the presumption strong; and\n(2) the state proves by clear and convincing evidence that no release conditions will reasonably protect the safety of any other person or the community.\n(This question concerns Article 1, Section 17 of the Constitution of the State of Indiana.)"},{"id":"in-boone-q-public-question-2","name":"Public Question #2","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the Constitution of the State of Indiana be amended to permit the judge of a city or town court to reside in: (1) the county in which the court is located; or (2) the bordering county closest to the city or town in which the court is located? (This question concerns Article 6, Section 6 of the Constitution of the State of Indiana.)"},{"id":"in-boone-q-2026-public-building-a-new-police-station","name":"2026 Public building a new Police station — public question","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall the City of Lebanon, Indiana increase property taxes paid to the City for no more than 20 years for the purpose of funding all or any portion of the cost of the design, construction and equipping of a new police headquarters in the City, together with the acquisition of related real property, as required, and any related improvements thereto, for which the principal debt amount for the project will cost no more than $52,165,000 and the financing cost including interest and fees will cost no more than an additional $35,918,413 and is estimated to increase the property taxes paid to the City by imposing a property tax rate that results in a maximum annual amount that does not exceed $4,454,550.  If this capital referendum public question is approved by the voters, for a median residence of the $250,000, the property's annual property tax bill would increase by $216 per year."},{"id":"in-boone-q-sheridan-community-schools","name":"Sheridan Community Schools — public question","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall Sheridan Community School Corporation increase property taxes paid to the school corporation for no more than eight (8) years for the purpose of funding and sustaining educational and operational stability in response to reductions in property tax revenue, including the retention and attraction of teachers and staff, academic related programs and operational expenses by imposing a property tax rate that does not exceed $0.40 and results in a maximum annual amount that does not exceed $2,900,000.  If this operating referendum public question is approved by the voters, for a median residence of $250,000, the property's annual property tax bill would increase by $454 per year.  The most recent operating referendum public question proposed by the school corporation was held in 2023 and passed."},{"id":"in-boone-q-zionsville-community-schools-ref","name":"Zionsville Community Schools Ref — public question","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall Zionsville Community Schools increase property taxes paid to the school corporation for no more than  eight (8) years for the purpose of funding and sustaining academic and educationally related programs and managing class sizes which reflect community standards by imposing a property tax rate that does not exceed 0.4128 and results in a maximum annual amount that does not exceed $21,463,325. If this operating referendum public question is approved by the voters, for a median residence of $600,000.00, the property's annual property tax bill would increase by $1,368.00 per year. The most recent property tax referendum proposed by the school corporation was held in 2019 and passed."},{"id":"in-boone-q-court-of-appeals-judicial-retention-fourth-district","name":"Court of Appeals Judicial Retention - Fourth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Mary A. DeBoer be retained in office?"},{"id":"in-boone-q-court-of-appeals-judicial-retention-fifth-district","name":"Court of Appeals Judicial Retention - Fifth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Paul A. Felix be retained in office?"},{"id":"in-boone-q-retention-of-judge-of-the-indiana-tax-court","name":"Retention of Judge of the Indiana Tax Court","type":"Tax Court Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Justin L. McAdam be retained in office?"}]}