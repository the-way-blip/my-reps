rticle 6, Section 6 of the Constitution of the State of Indiana.)"},{"id":"in-jackson-q-court-of-appeals-judicial-retention-fourth-district","name":"Court of Appeals Judicial Retention - Fourth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Mary A. DeBoer be retained in office?"},{"id":"in-jackson-q-court-of-appeals-judicial-retention-fifth-district","name":"Court of Appeals Judicial Retention - Fifth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Paul A. Felix be retained in office?"},{"id":"in-jackson-q-retention-of-judge-of-the-indiana-tax-court","name":"Retention of Judge of the Indiana Tax Court","type":"Tax Court Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Justin L. McAdam be retained in office?"}]}