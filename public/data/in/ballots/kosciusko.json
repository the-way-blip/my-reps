icial sample ballot at IndianaVoters.in.gov.","maybe":true,"ballotOrder":420,"candidates":[{"name":"Deb Thomas","party":"republican","status":"candidate"}]},{"id":"in-kosciusko-2087","officeId":"2087","office":"Whitko School Board, District 5 (Kosciusko, Whitley)","category":"School Board Member","level":"School Board","scope":"school","area":"Whitko","seats":1,"type":"partisan","description":"May be on your ballot: only voters in this district vote on this seat. Check your official sample ballot at IndianaVoters.in.gov.","maybe":true,"ballotOrder":420,"candidates":[{"name":"Scott Werstler","party":"republican","status":"candidate"}]}],"referendums":[{"id":"in-kosciusko-q-public-question-1","name":"Public Question #1","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Currently, under the Constitution of the State of Indiana, a person charged with murder or treason is not entitled to be released on bail if the proof is evident or the presumption strong. Shall the Constitution of the State of Indiana be amended to provide that a person charged with an offense other than murder or treason is not entitled to bail if:\n(1) the proof is evident or the presumption strong; and\n(2) the state proves by clear and convincing evidence that no release conditions will reasonably protect the safety of any other person or the community.\n(This question concerns Article 1, Section 17 of the Constitution of the State of Indiana.)"},{"id":"in-kosciusko-q-public-question-2","name":"Public Question #2","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the Constitution of the State of Indiana be amended to permit the judge of a city or town court to reside in: (1) the county in which the court is located; or (2) the bordering county closest to the city or town in which the court is located? (This question concerns Article 6, Section 6 of the Constitution of the State of Indiana.)"},{"id":"in-kosciusko-q-wa-nee-community-school-corporation-school-safety-referendum","name":"Wa-Nee Community School Corporation School Safety Referendum","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall the Wa-Nee Community School Corporation increase property taxes paid to the school corporation for no more than eight (8) years for the purpose of funding improvements for the safety, security, and well-being of Wa-Nee students by imposing a property tax rate that does not exceed $0.10 and results in a maximum annual amount that does not exceed $1,750,000. If this school safety referendum public question is approved by the voters, for a median residence of $250,000, the property's annual property tax bill would increase by $114 per year."},{"id":"in-kosciusko-q-court-of-appeals-judicial-retention-fourth-district","name":"Court of Appeals Judicial Retention - Fourth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Mary A. DeBoer be retained in office?"},{"id":"in-kosciusko-q-court-of-appeals-judicial-retention-fifth-district","name":"Court of Appeals Judicial Retention - Fifth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Paul A. Felix be retained in office?"},{"id":"in-kosciusko-q-retention-of-judge-of-the-indiana-tax-court","name":"Retention of Judge of the Indiana Tax Court","type":"Tax Court Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Justin L. McAdam be retained in office?"}]}