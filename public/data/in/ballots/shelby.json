0,"candidates":[{"name":"Amanda (Mandy) Bunton","party":null,"status":"candidate"}]},{"id":"in-shelby-2747","officeId":"2747","office":"Shelbyville Central School Board, District 4","category":"School Board Member","level":"School Board","scope":"school","area":"Shelbyville Central","seats":2,"type":"nonpartisan","description":"Vote for up to 2. Some school boards elect district seats only by voters in that district — check your sample ballot.","ballotOrder":420,"candidates":[{"name":"Sara DePrez Lewis","party":null,"status":"candidate"},{"name":"Julie Ruschhaupt","party":null,"status":"candidate"}]}],"referendums":[{"id":"in-shelby-q-public-question-1","name":"Public Question #1","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Currently, under the Constitution of the State of Indiana, a person charged with murder or treason is not entitled to be released on bail if the proof is evident or the presumption strong. Shall the Constitution of the State of Indiana be amended to provide that a person charged with an offense other than murder or treason is not entitled to bail if:\n(1) the proof is evident or the presumption strong; and\n(2) the state proves by clear and convincing evidence that no release conditions will reasonably protect the safety of any other person or the community.\n(This question concerns Article 1, Section 17 of the Constitution of the State of Indiana.)"},{"id":"in-shelby-q-public-question-2","name":"Public Question #2","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the Constitution of the State of Indiana be amended to permit the judge of a city or town court to reside in: (1) the county in which the court is located; or (2) the bordering county closest to the city or town in which the court is located? (This question concerns Article 6, Section 6 of the Constitution of the State of Indiana.)"},{"id":"in-shelby-q-shelbyville-central-schools-proposed-revenue-spending-plan","name":"Shelbyville Central Schools Proposed Revenue Spending Plan — public question","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall Shelbyville Central Schools increase property taxes paid to the school corporation for no more than 8 years for the purpose of funding and maintaining current educational and operational programs in response to reductions in property tax revenue, including student transportation, maintaining class sizes, school safety, and recruiting and retaining staff, by imposing a property tax rate that does not exceed $0.22 and results in a maximum annual amount that does not exceed $3,606,064. If this operating referendum public question is approved by the voters, for a median residence of $200,000, this property's annual property tax bill would increase by $191 per year."},{"id":"in-shelby-q-court-of-appeals-judicial-retention-fourth-district","name":"Court of Appeals Judicial Retention - Fourth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Mary A. DeBoer be retained in office?"},{"id":"in-shelby-q-court-of-appeals-judicial-retention-fifth-district","name":"Court of Appeals Judicial Retention - Fifth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Paul A. Felix be retained in office?"},{"id":"in-shelby-q-retention-of-judge-of-the-indiana-tax-court","name":"Retention of Judge of the Indiana Tax Court","type":"Tax Court Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Justin L. McAdam be retained in office?"}]}