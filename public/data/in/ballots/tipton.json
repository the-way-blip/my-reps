:"partisan","description":"","ballotOrder":420,"candidates":[{"name":"Robert C. Cochrane, II","party":"republican","status":"candidate"}]},{"id":"in-tipton-2298","officeId":"2298","office":"Tipton Community School Board, City of Tipton","category":"School Board Member","level":"School Board","scope":"school","area":"Tipton Community","seats":2,"type":"partisan","description":"Vote for up to 2.","ballotOrder":420,"candidates":[{"name":"Caiden C. McNew","party":"democratic","status":"candidate"},{"name":"Tamera Noble Brown","party":"republican","status":"candidate"},{"name":"Eric Underwood","party":"republican","status":"candidate"},{"name":"Christopher K. McNew","party":"Independent","status":"candidate"}]},{"id":"in-tipton-1048","officeId":"1048","office":"Tipton Tri-Central School Board, At Large","category":"School Board Member","level":"School Board","scope":"school","area":"Tipton Tri-Central","seats":1,"type":"partisan","description":"","ballotOrder":420,"candidates":[{"name":"Braden Brady Peters","party":"Independent","status":"candidate"}]},{"id":"in-tipton-3167","officeId":"3167","office":"Tipton Tri-Central School Board, Wildcat Township","category":"School Board Member","level":"School Board","scope":"school","area":"Tipton Tri-Central","seats":1,"type":"nonpartisan","description":"","ballotOrder":420,"candidates":[{"name":"Danielle Sexton","party":null,"status":"candidate"}]}],"referendums":[{"id":"in-tipton-q-public-question-1","name":"Public Question #1","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Currently, under the Constitution of the State of Indiana, a person charged with murder or treason is not entitled to be released on bail if the proof is evident or the presumption strong. Shall the Constitution of the State of Indiana be amended to provide that a person charged with an offense other than murder or treason is not entitled to bail if:\n(1) the proof is evident or the presumption strong; and\n(2) the state proves by clear and convincing evidence that no release conditions will reasonably protect the safety of any other person or the community.\n(This question concerns Article 1, Section 17 of the Constitution of the State of Indiana.)"},{"id":"in-tipton-q-public-question-2","name":"Public Question #2","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the Constitution of the State of Indiana be amended to permit the judge of a city or town court to reside in: (1) the county in which the court is located; or (2) the bordering county closest to the city or town in which the court is located? (This question concerns Article 6, Section 6 of the Constitution of the State of Indiana.)"},{"id":"in-tipton-q-tipton-community-school-corporation","name":"Tipton Community School Corporation — public question","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall the Tipton Community School Corporation increase property taxes paid to the school corporation for no more than eight (8) years for the purpose of providing funding to maintain academic programs, class sizes, and student support, health, and safety services, attract and retain teachers and support staff, maintain student transportation services, and sustain educational and operational funding stability by imposing a property tax rate that does not exceed $0.25 and results in a maximum annual amount that does not exceed $2,000,000. If this operating referendum public question is approved by the voters, for a median residence of $200,000, the property’s annual property tax bill would increase by $216 per year."},{"id":"in-tipton-q-tri-central-community-school-corporation","name":"Tri-Central Community School Corporation — public question","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall Tri-Central Community Schools increase property taxes paid to the school corporation for no more than eight (8) years for the purpose of funding and maintaining daily educational operations, including recruiting and retaining teachers and staff, supporting essential safety initiatives, and maintaining class sizes, academic programs and opportunities to meet the learning needs of all students in response to reductions in property tax revenue by imposing a property tax rate that does not exceed $0.24 and results in a maximum annual amount that does not exceed $1,100,000. If this operating referendum public question is approved by the voters, for a median residence of $150,000, the property's annual property tax bill would increase by $143 per year."},{"id":"in-tipton-q-court-of-appeals-judicial-retention-fourth-district","name":"Court of Appeals Judicial Retention - Fourth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Mary A. DeBoer be retained in office?"},{"id":"in-tipton-q-court-of-appeals-judicial-retention-fifth-district","name":"Court of Appeals Judicial Retention - Fifth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Paul A. Felix be retained in office?"},{"id":"in-tipton-q-court-of-appeals-judicial-retention-second-district","name":"Court of Appeals Judicial Retention - Second District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Dana J. Kenworthy be retained in office?"},{"id":"in-tipton-q-retention-of-judge-of-the-indiana-tax-court","name":"Retention of Judge of the Indiana Tax Court","type":"Tax Court Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Justin L. McAdam be retained in office?"}]}