-1410","officeId":"1410","office":"Eastern Pulaski School Board, Franklin Township (Pulaski)","category":"School Board Member","level":"School Board","scope":"school","area":"Eastern Pulaski","seats":1,"type":"partisan","description":"","ballotOrder":420,"candidates":[{"name":"Tim Rausch","party":"republican","status":"candidate"}]},{"id":"in-pulaski-4439","officeId":"4439","office":"Eastern Pulaski School Board, Harrison Township (Pulaski, Fulton)","category":"School Board Member","level":"School Board","scope":"school","area":"Eastern Pulaski","seats":1,"type":"partisan","description":"","ballotOrder":420,"candidates":[{"name":"Joe A Cunningham","party":"republican","status":"candidate"}]},{"id":"in-pulaski-2807","officeId":"2807","office":"Eastern Pulaski School Board, Indian Creek Township (Pulaski)","category":"School Board Member","level":"School Board","scope":"school","area":"Eastern Pulaski","seats":1,"type":"nonpartisan","description":"","ballotOrder":420,"candidates":[{"name":"Aaron Campbell","party":null,"status":"candidate"}]},{"id":"in-pulaski-3986","officeId":"3986","office":"West Central School Board, Cass Township (Pulaski, Jasper)","category":"School Board Member","level":"School Board","scope":"school","area":"West Central","seats":1,"type":"nonpartisan","description":"","ballotOrder":420,"candidates":[{"name":"Heather Marie Reese","party":null,"status":"candidate"}]},{"id":"in-pulaski-1281","officeId":"1281","office":"West Central School Board, Salem Township (Pulaski, Jasper)","category":"School Board Member","level":"School Board","scope":"school","area":"West Central","seats":1,"type":"partisan","description":"","ballotOrder":420,"candidates":[{"name":"Lindsey Geyer","party":"republican","status":"candidate"},{"name":"Jamie (Jay) Johnson","party":"republican","status":"candidate"}]}],"referendums":[{"id":"in-pulaski-q-public-question-1","name":"Public Question #1","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Currently, under the Constitution of the State of Indiana, a person charged with murder or treason is not entitled to be released on bail if the proof is evident or the presumption strong. Shall the Constitution of the State of Indiana be amended to provide that a person charged with an offense other than murder or treason is not entitled to bail if:\n(1) the proof is evident or the presumption strong; and\n(2) the state proves by clear and convincing evidence that no release conditions will reasonably protect the safety of any other person or the community.\n(This question concerns Article 1, Section 17 of the Constitution of the State of Indiana.)"},{"id":"in-pulaski-q-public-question-2","name":"Public Question #2","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the Constitution of the State of Indiana be amended to permit the judge of a city or town court to reside in: (1) the county in which the court is located; or (2) the bordering county closest to the city or town in which the court is located? (This question concerns Article 6, Section 6 of the Constitution of the State of Indiana.)"},{"id":"in-pulaski-q-culver-school-tax-increase","name":"Culver School Tax Increase — public question","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall Culver Community Schools Corporation increase property taxes paid to the school corporation for no more than eight (8) years for the purpose of funding and sustaining educational and operational funding stability in response to reductions in property tax revenue, including maintaining student safety, health, and well-being initiatives; attracting, retaining, and supporting teachers and staff; maintaining class sizes; and funding academic and support programs to meet the educational needs of all students, by imposing a property tax rate that does not exceed $0.24 and results in a maximum annual amount that does not exceed $2,899,000? If this operating referendum public question is approved by the voters, for a median residence of $200,000, the property's annual property tax bill would increase by $208 per year. The most recent operating referendum public question proposed by the school corporation was held in November 2018 and passed."},{"id":"in-pulaski-q-court-of-appeals-judicial-retention-fourth-district","name":"Court of Appeals Judicial Retention - Fourth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Mary A. DeBoer be retained in office?"},{"id":"in-pulaski-q-court-of-appeals-judicial-retention-fifth-district","name":"Court of Appeals Judicial Retention - Fifth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Paul A. Felix be retained in office?"},{"id":"in-pulaski-q-retention-of-judge-of-the-indiana-tax-court","name":"Retention of Judge of the Indiana Tax Court","type":"Tax Court Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Justin L. McAdam be retained in office?"}]}