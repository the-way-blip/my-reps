ybe":true,"ballotOrder":420,"candidates":[{"name":"Mark A. Werno","party":"republican","status":"candidate"},{"name":"Christine E Kostbade","party":null,"status":"candidate"}]},{"id":"in-porter-3127","officeId":"3127","office":"Union Twp. School Board Member 4th Dist.general Elections (Porter)","category":"School Board Member","level":"School Board","scope":"school","area":"Union Twp.","seats":1,"type":"partisan","description":"May be on your ballot: only voters in this district vote on this seat. Check your official sample ballot at IndianaVoters.in.gov.","maybe":true,"ballotOrder":420,"candidates":[{"name":"Jocelyn Prue","party":"Independent","status":"candidate"},{"name":"Leah Pagone","party":null,"status":"candidate"}]},{"id":"in-porter-2906","officeId":"2906","office":"Union Twp. School Board Member At Large General Elections (Porter)","category":"School Board Member","level":"School Board","scope":"school","area":"Union Twp.","seats":1,"type":"nonpartisan","description":"","ballotOrder":420,"candidates":[{"name":"Kevin Ribordy","party":null,"status":"candidate"}]}],"referendums":[{"id":"in-porter-q-public-question-1","name":"Public Question #1","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Currently, under the Constitution of the State of Indiana, a person charged with murder or treason is not entitled to be released on bail if the proof is evident or the presumption strong. Shall the Constitution of the State of Indiana be amended to provide that a person charged with an offense other than murder or treason is not entitled to bail if:\n(1) the proof is evident or the presumption strong; and\n(2) the state proves by clear and convincing evidence that no release conditions will reasonably protect the safety of any other person or the community.\n(This question concerns Article 1, Section 17 of the Constitution of the State of Indiana.)"},{"id":"in-porter-q-public-question-2","name":"Public Question #2","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the Constitution of the State of Indiana be amended to permit the judge of a city or town court to reside in: (1) the county in which the court is located; or (2) the bordering county closest to the city or town in which the court is located? (This question concerns Article 6, Section 6 of the Constitution of the State of Indiana.)"},{"id":"in-porter-q-michigan-city-area-schools","name":"Michigan City Area Schools — public question","type":"Local Public Question","statewide":false,"ballotLanguage":"SHALL THE MICHIGAN CITY AREA SCHOOLS INCREASE PROPERTY TAXES PAID TO THE SCHOOL CORPORATION FOR NO MORE THAN EIGHT (8) YEARS TO SUPPORT THE MAXIMIZE COMMUNITY AND STUDENTS (MCAS) INITIATIVE WHICH WILL SUSTAIN EDUCATIONAL AND OPERATIONAL FUNDING STABILITY IN RESPONSE TO REDUCTIONS IN PROPERTY TAX REVENUE BY RECRUITING AND RETAINING TEACHERS AND STAFF, SUPPORTING ESSENTIAL STUDENT HEALTH AND SAFETY INITIATIVES, AND MAINTAINING CLASS SIZES, ACADEMIC PROGRAMS, AND OPPORTUNITIES TO MEET EDUCATIONAL NEEDS. THIS WILL BE ACHIEVED BY IMPOSING A PROPERTY TAX RATE THAT DOES NOT EXCEED $0.2998 AND RESULTS IN A MAXIMUM ANNUAL AMOUNT THAT DOES NOT EXCEED $0.2998 AND RESULTS IN A MAXIMUM ANNUAL AMOUNT THAT DOES NOT EXCEED $10,000,000. IF THIS OPERATING REFERENDUM PUBLIC QUESTIONS IS APPROVED BY THE VOTERS, THE PROPERTY'S ANNUAL PROPERTY TAX BILL FOR A MEDIAN RESIDENCE OF $200,000 WOULD INCREASE BY $260 PER YEAR."},{"id":"in-porter-q-porter-township-school-corporation","name":"Porter Township School Corporation — public question","type":"Local Public Question","statewide":false,"ballotLanguage":"SHALL PORTER TOWNSHIP SCHOOL CORPORATION INCREASE PROPERTY TAXES PAID TO THE SCHOOL CORPORATION FOR NO MORE THAN EIGHT (8) YEARS FOR THE PURPOSE OF FUNDING AND SUSTAINING EDUCATIONAL AND OPERATIONAL FUNDING STABILITY IN RESPONSE TO REDUCTIONS IN PROPERTY TAX REVENUE, INCLUDING MAINTAINING ESSENTIAL HEALTH AND SAFETY INITIATIVES, INCLUDING THE EMPLOYMENT AND RETENTION OF SCHOOL RESOURCE OFFICERS, SUPPORTING AND RETAINING TEACHERS AND STAFF, MANAGING CLASS SIZES, MAINTAINING ESSENTIAL STUDENT TRANSPORTATION AND FUNDING ACADEMIC AND SUPPORT PROGRAMS TO MEET THE EDUCATIONAL NEEDS OF ALL STUDENTS, BY IMPOSING A PROPERTY TAX RATE THAT DOES NOT EXCEED $0.3576 AND RESULTS IN A MAXIMUM ANNUAL AMOUNT THAT DOES NOT EXCEED $3,500,000. IF THIS OPERATING REFERENDUM PUBLIC QUESTION IS APPROVED BY THE VOTERS, FOR A MEDIAN RESIDENCE OF $ 350,000.00, THE PROPERTY'S ANNUAL PROPERTY TAX BILL WOULD INCREASE BY $599.00 PER YEAR."},{"id":"in-porter-q-union-township-school-corporation","name":"Union Township School Corporation — public question","type":"Local Public Question","statewide":false,"ballotLanguage":"SHALL UNION TOWNSHIP SCHOOL CORPORATION INCREASE PROPERTY TAXES PAID TO THE SCHOOL CORPORATION FOR NO MORE THAN EIGHT (8) YEARS FOR THE PURPOSE OF FUNDING AND CONTINUING EDUCATIONAL AND OPERATIONAL STABILITY IN RESPONSE TO REDUCTIONS IN PROPERTY TAX REVENUE, INCLUDING ATTRACTING AND RETAINING TEACHERS AND STAFF, MAINTAINING CLASS SIZES, MAINTAINING ACADEMIC AND EDUCATIONALLY RELATED PROGRAMS, AND MAINTAINING ESSENTIAL SAFETY AND SECURITY STANDARDS FOR THE CHILDREN OF UNION TOWNSHIP BY IMPOSING A PROPERTY TAX RATE THAT DOES NOT EXCEED $0.35 AND RESULTS IN A MAXIMUM ANNUAL AMOUNT THAT DOES NOT EXCEED $3,374,291. IF THIS OPERATING REFERENDUM PUBLIC QUESTION IS APPROVED BY THE VOTERS, FOR A MEDIAN RESIDENCE OF $400,000, THE PROPERTY'S ANNUAL PROPERTY TAX BILL WOULD INCREASE BY $681 PER YEAR."},{"id":"in-porter-q-court-of-appeals-judicial-retention-fourth-district","name":"Court of Appeals Judicial Retention - Fourth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Mary A. DeBoer be retained in office?"},{"id":"in-porter-q-court-of-appeals-judicial-retention-fifth-district","name":"Court of Appeals Judicial Retention - Fifth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Paul A. Felix be retained in office?"},{"id":"in-porter-q-retention-of-judge-of-the-indiana-tax-court","name":"Retention of Judge of the Indiana Tax Court","type":"Tax Court Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Justin L. McAdam be retained in office?"}]}