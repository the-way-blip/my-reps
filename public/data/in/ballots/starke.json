llotOrder":420,"candidates":[{"name":"Jason Downs","party":"republican","status":"candidate"},{"name":"Mary Lynn Ritchie","party":null,"status":"candidate"}]},{"id":"in-starke-3135","officeId":"3135","office":"Knox School Board, Center","category":"School Board Member","level":"School Board","scope":"school","area":"Knox","seats":1,"type":"partisan","description":"","ballotOrder":420,"candidates":[{"name":"Julie Berndt","party":"democratic","status":"candidate"},{"name":"Raymond Edward Stephenson","party":"republican","status":"candidate"},{"name":"Gary L. Dulin","party":null,"status":"candidate"}]},{"id":"in-starke-4608","officeId":"4608","office":"Knox School Board, Washington","category":"School Board Member","level":"School Board","scope":"school","area":"Knox","seats":1,"type":"partisan","description":"","ballotOrder":420,"candidates":[{"name":"Erin Duff","party":"republican","status":"candidate"},{"name":"Brooke Norem","party":"republican","status":"candidate"}]},{"id":"in-starke-1646","officeId":"1646","office":"Oregon Davis School Board At Large","category":"School Board Member","level":"School Board","scope":"school","area":"Oregon Davis","seats":3,"type":"partisan","description":"Vote for up to 3.","ballotOrder":420,"candidates":[{"name":"Kyle James Hinds","party":"republican","status":"candidate"},{"name":"Holly Leinbach Richwalski","party":"republican","status":"candidate"},{"name":"Kyle Burch","party":"Independent","status":"candidate"},{"name":"Bradley Hazelton","party":"Independent","status":"candidate"},{"name":"Kurt Hayes","party":null,"status":"candidate"}]}],"referendums":[{"id":"in-starke-q-public-question-1","name":"Public Question #1","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Currently, under the Constitution of the State of Indiana, a person charged with murder or treason is not entitled to be released on bail if the proof is evident or the presumption strong. Shall the Constitution of the State of Indiana be amended to provide that a person charged with an offense other than murder or treason is not entitled to bail if:\n(1) the proof is evident or the presumption strong; and\n(2) the state proves by clear and convincing evidence that no release conditions will reasonably protect the safety of any other person or the community.\n(This question concerns Article 1, Section 17 of the Constitution of the State of Indiana.)"},{"id":"in-starke-q-public-question-2","name":"Public Question #2","type":"Ratification Of State Constitutional Amendment","statewide":true,"ballotLanguage":"Shall the Constitution of the State of Indiana be amended to permit the judge of a city or town court to reside in: (1) the county in which the court is located; or (2) the bordering county closest to the city or town in which the court is located? (This question concerns Article 6, Section 6 of the Constitution of the State of Indiana.)"},{"id":"in-starke-q-culver-school-tax-increase","name":"Culver School Tax Increase — public question","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall Culver Community Schools Corporation increase property taxes paid to the school corporation for no more than eight (8) years for the purpose of funding and sustaining educational and operational funding stability in response to reductions in property tax revenue, including maintaining student safety, health, and well-being initiatives; attracting, retaining, and supporting teachers and staff; maintaining class sizes; and funding academic and support programs to meet the educational needs of all students, by imposing a property tax rate that does not exceed $0.24 and results in a maximum annual amount that does not exceed $2,899,000? If this operating referendum public question is approved by the voters, for a median residence of $200,000, the property's annual property tax bill would increase by $208 per year. The most recent operating referendum public question proposed by the school corporation was held in November 2018 and passed."},{"id":"in-starke-q-reduction-and-continuation-of-oregon-davis-school-corporation-operation-levy","name":"Reduction and Continuation of Oregon-Davis School Corporation Operation Levy — public question","type":"Local Public Question","statewide":false,"ballotLanguage":"Shall the Oregon-Davis School Corporation continue to increase property taxes paid to the school corporation for no more than eight (8) years for the purpose of funding current educational and operational expenses by imposing a property tax rate that does not exceed nineteen cents ($0.19) and results in a maximum annual amount that does not exceed $800,000?  If this operating referendum is NOT approved by the voters, for a median residence of $150,000, the property's annual tax bill would decrease by $173 per year.  If this operating referendum public question is approved by the voters, it would be renewal of the most recent operating referendum public question passed in 2018 with a property tax rate of twenty-nine cents ($0.29)."},{"id":"in-starke-q-court-of-appeals-judicial-retention-fourth-district","name":"Court of Appeals Judicial Retention - Fourth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Mary A. DeBoer be retained in office?"},{"id":"in-starke-q-court-of-appeals-judicial-retention-fifth-district","name":"Court of Appeals Judicial Retention - Fifth District","type":"Court Of Appeals Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Paul A. Felix be retained in office?"},{"id":"in-starke-q-retention-of-judge-of-the-indiana-tax-court","name":"Retention of Judge of the Indiana Tax Court","type":"Tax Court Judge Retention","statewide":false,"ballotLanguage":"Shall Judge Justin L. McAdam be retained in office?"}]}