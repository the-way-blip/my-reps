# Congress.gov API key — request one at https://api.congress.gov/sign-up/
VITE_CONGRESS_API_KEY=your_congress_api_key_here

# Google Civic Information API key — enable at https://console.cloud.google.com/
VITE_GOOGLE_CIVIC_API_KEY=your_google_civic_api_key_here

# Open States API key — register at https://openstates.org/accounts/signup/
VITE_OPENSTATES_API_KEY=your_openstates_api_key_here

# FEC (Federal Election Commission) API key — request at https://api.open.fec.gov/developers/
VITE_FEC_API_KEY=your_fec_api_key_here

# Supabase project URL and anon/public key — find in your Supabase dashboard under Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# GoHighLevel CRM webhook URL (SERVER-SIDE ONLY — set in Vercel Environment Variables, not in .env)
# Create an "Inbound Webhook" trigger in a GHL workflow and paste the URL here.
# Set this in Vercel Dashboard > Project > Settings > Environment Variables as GHL_WEBHOOK_URL
# GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-webhook-id
